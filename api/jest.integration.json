{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "src",
  "testRegex": "test/integration/.*\\.real\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node",
  "testTimeout": 15000,
  "moduleNameMapper": {
    "^@signaldesk/shared$": "<rootDir>/../../packages/shared/src/index.ts"
  }
}
